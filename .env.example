# ============================================================
# CivicAssist - Greenfield Municipal Corporation
# Environment Configuration
# ============================================================

# LLM Provider: 'gemini', 'openai', or leave blank/commented for zero-hallucination grounded fallback
LLM_PROVIDER=gemini

# Google Gemini API Key (optional - if omitted, verified grounded fallback provider is used)
GEMINI_API_KEY=

# OpenAI API Key (optional - if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Weather API keys (optional - if omitted, municipal forecast simulation is used)
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=

# Frontend API Base URL (used by React/Vite to target FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000
